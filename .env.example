# PostgreSQL connection string (Supabase: Transaction pooler URI + ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session signing secret — generate your own with:  openssl rand -hex 32
AUTH_SECRET="replace-with-your-own-64-char-hex-secret"
